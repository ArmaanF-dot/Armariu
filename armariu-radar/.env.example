# Copy to .env (never commit .env). Get keys at https://developer.company-information.service.gov.uk:
# create a Live application, then add two keys to it: an "API key" (REST) and a "Stream key".
CH_REST_KEY=
CH_STREAM_KEY=

# Optional: weekday the weekly digest is written (0=Monday ... 6=Sunday). Default 0.
RADAR_DIGEST_WEEKDAY=0
